<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables></variables>
  <block type="trade_definition" id="even_odd_ai_trade_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="even_odd_ai_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="even_odd_ai_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="even_odd_ai_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="even_odd_ai_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="even_odd_ai_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="even_odd_ai_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="even_odd_ai_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="even_odd_ai_duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="even_odd_ai_amount">
            <field name="NUM">0.35</field>
          </shadow>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="even_odd_ai_after_purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again" id="even_odd_ai_trade_again"></block>
    </statement>
  </block>
  <block type="before_purchase" id="even_odd_ai_before_purchase" deletable="false" x="0" y="576">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="even_odd_ai_purchase">
        <field name="PURCHASE_LIST">DIGITEVEN</field>
      </block>

<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="smart_over2_var_stake">Stake</variable>
    <variable id="smart_over2_var_martingale">Martingale factor</variable>
    <variable id="smart_over2_var_target_profit">Target Profit</variable>
    <variable id="smart_over2_var_stop_loss">Stop Loss</variable>
    <variable id="smart_over2_var_use_martingale">Use Martingale</variable>
    <variable id="smart_over2_var_over_prediction">Over prediction (2)</variable>
    <variable id="smart_over2_var_recovery_prediction">Recovery prediction (4)</variable>
  </variables>
  <block type="trade_definition" id="smart_over2_trade_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="smart_over2_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="smart_over2_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="smart_over2_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="smart_over2_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="smart_over2_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="smart_over2_restart_on_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="smart_over2_set_stake">
        <field name="VAR" id="smart_over2_var_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="smart_over2_stake_default">
            <field name="NUM">0.5</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="smart_over2_set_martingale">
            <field name="VAR" id="smart_over2_var_martingale">Martingale factor</field>
            <value name="VALUE">
              <block type="math_number" id="smart_over2_martingale_default">
                <field name="NUM">1.2</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="smart_over2_set_target_profit">
                        <field name="VAR" id="smart_over2_var_target_profit">Target Profit</field>
                        <value name="VALUE">
                          <block type="math_number" id="smart_over2_target_profit_default">
                            <field name="NUM">5</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="smart_over2_set_stop_loss">
                            <field name="VAR" id="smart_over2_var_stop_loss">Stop Loss</field>
                            <value name="VALUE">
                              <block type="math_number" id="smart_over2_stop_loss_default">
                                <field name="NUM">30</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="smart_over2_set_use_martingale">
                                <field name="VAR" id="smart_over2_var_use_martingale">Use Martingale</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="smart_over2_use_martingale_default">
                                    <field name="BOOL">TRUE</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="smart_over2_set_over_prediction">
                                    <field name="VAR" id="smart_over2_var_over_prediction">Over prediction (2)</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="smart_over2_over_prediction_default">
                                        <field name="NUM">2</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="smart_over2_set_recovery_prediction">
                                        <field name="VAR" id="smart_over2_var_recovery_prediction">Recovery prediction (4)</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="smart_over2_recovery_prediction_default">
                                            <field name="NUM">4</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="smart_over2_recovery_settings" id="smart_over2_recovery_settings">
                                            <field name="ENTRY_DIGIT_COUNT">4</field>
                                            <field name="USE_VIRTUAL_HOOK">TRUE</field>
                                            <field name="MAX_VIRTUAL_LOSSES">2</field>
                                            <field name="RECOVERY_CONTRACT_TYPE">DIGITOVER</field>
                                          </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="smart_over2_trade_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="smart_over2_duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="smart_over2_stake">
            <field name="NUM">0.5</field>
          </shadow>
          <block type="variables_get" id="smart_over2_get_stake">
            <field name="VAR" id="smart_over2_var_stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="smart_over2_prediction">
            <field name="NUM">2</field>
          </shadow>
          <block type="variables_get" id="smart_over2_get_over_prediction">
            <field name="VAR" id="smart_over2_var_over_prediction">Over prediction (2)</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="smart_over2_after_purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="smart_over2_recovery_settlement" id="smart_over2_recovery_settlement">
        <next>
          <block type="trade_again" id="smart_over2_trade_again"></block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="smart_over2_before_purchase" deletable="false" x="0" y="576">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="smart_over2_entry_if">
        <value name="IF0">
          <block type="smart_over2_recovery_gate" id="smart_over2_recovery_gate">
            <value name="ANALYSIS_COUNT">
              <shadow type="math_number" id="smart_over2_analysis_count">
                <field name="NUM">100</field>
              </shadow>
            </value>
            <value name="MARTINGALE">
              <shadow type="math_number" id="smart_over2_martingale_multiplier">
                <field name="NUM">1.2</field>
              </shadow>
              <block type="variables_get" id="smart_over2_get_martingale">
                <field name="VAR" id="smart_over2_var_martingale">Martingale factor</field>
              </block>
            </value>
            <value name="USE_MARTINGALE">
              <block type="variables_get" id="smart_over2_get_use_martingale">
                <field name="VAR" id="smart_over2_var_use_martingale">Use Martingale</field>
              </block>
            </value>
            <value name="OVER_PREDICTION">
              <block type="variables_get" id="smart_over2_get_over_prediction_gate">
                <field name="VAR" id="smart_over2_var_over_prediction">Over prediction (2)</field>
              </block>
            </value>
            <value name="RECOVERY_PREDICTION">
              <block type="variables_get" id="smart_over2_get_recovery_prediction">
                <field name="VAR" id="smart_over2_var_recovery_prediction">Recovery prediction (4)</field>
              </block>
            </value>
            <value name="TARGET_PROFIT">
              <block type="variables_get" id="smart_over2_get_target_profit">
                <field name="VAR" id="smart_over2_var_target_profit">Target Profit</field>
              </block>
            </value>
            <value name="STOP_LOSS">
              <block type="variables_get" id="smart_over2_get_stop_loss">
                <field name="VAR" id="smart_over2_var_stop_loss">Stop Loss</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="smart_over2_recovery_purchase" id="smart_over2_purchase"></block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="hl_stake">Stake per contract</variable>
  </variables>
  <block type="trade_definition" id="hl_trade_definition" deletable="false" x="20" y="20">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="hl_market">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="hl_trade_type">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="hl_contract_type">
                <field name="TYPE_LIST">both</field>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="hl_stake_init">
        <field name="VAR" id="hl_stake">Stake per contract</field>
        <value name="VALUE">
          <block type="math_number" id="hl_stake_value"><field name="NUM">0.35</field></block>
        </value>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="hl_options">
        <mutation has_first_barrier="true" has_second_barrier="false" has_prediction="false"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT">
          <shadow type="math_number"><field name="NUM">0.35</field></shadow>
          <block type="variables_get" id="hl_amount"><field name="VAR" id="hl_stake">Stake per contract</field></block>
        </value>
        <value name="BARRIER">
          <shadow type="text"><field name="TEXT">+0.001</field></shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="hl_before_purchase" deletable="false" x="720" y="20">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="hl_higher_purchase">
        <field name="PURCHASE_LIST">CALL</field>
        <next>
          <block type="purchase" id="hl_lower_purchase">
            <field name="PURCHASE_LIST">PUT</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="hl_after_purchase" deletable="false" x="1120" y="20"/>
</xml>
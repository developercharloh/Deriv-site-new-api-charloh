<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="adaptive_signal">Adaptive Signal</variable>
    <variable id="adaptive_cooldown">Cooldown Ticks</variable>
    <variable id="adaptive_profit_limit">Take Profit Limit</variable>
    <variable id="adaptive_loss_limit">Stop Loss Limit</variable>
  </variables>
  <block type="trade_definition" id="adaptive_trade_definition" deletable="false" x="0" y="40">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="adaptive_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="adaptive_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="adaptive_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="adaptive_candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="adaptive_restartbuysell">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="adaptive_restartonerror">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="adaptive_init_cooldown">
        <field name="VAR" id="adaptive_cooldown">Cooldown Ticks</field>
        <value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
        <next>
          <block type="variables_set" id="adaptive_init_profit">
            <field name="VAR" id="adaptive_profit_limit">Take Profit Limit</field>
            <value name="VALUE" strategy_value="profit"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
            <next>
              <block type="variables_set" id="adaptive_init_loss">
                <field name="VAR" id="adaptive_loss_limit">Stop Loss Limit</field>
                <value name="VALUE" strategy_value="loss"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="adaptive_tradeoptions">
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION" strategy_value="duration">
          <shadow type="math_number"><field name="NUM">3</field></shadow>
        </value>
        <value name="AMOUNT" strategy_value="stake">
          <shadow type="math_number"><field name="NUM">1</field></shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="adaptive_before_purchase" x="0" y="520">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="adaptive_session_gate">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="adaptive_limit_or">
            <field name="OP">OR</field>
            <value name="A">
              <block type="logic_compare" id="adaptive_profit_compare">
                <field name="OP">GTE</field>
                <value name="A"><block type="total_profit" id="adaptive_profit_value"></block></value>
                <value name="B"><block type="variables_get" id="adaptive_profit_limit_get"><field name="VAR" id="adaptive_profit_limit">Take Profit Limit</field></block></value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="adaptive_loss_compare">
                <field name="OP">LTE</field>
                <value name="A"><block type="total_profit" id="adaptive_loss_value"></block></value>
                <value name="B">
                  <block type="math_arithmetic" id="adaptive_negative_loss">
                    <field name="OP">MINUS</field>
                    <value name="A"><block type="math_number" id="adaptive_negative_zero"><field name="NUM">0</field></block></value>
                    <value name="B"><block type="variables_get" id="adaptive_loss_limit_get"><field name="VAR" id="adaptive_loss_limit">Stop Loss Limit</field></block></value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="adaptive_session_stop" id="adaptive_session_stop_block"><field name="REASON">session_risk_limit</field></block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="adaptive_cooldown_gate">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="adaptive_cooldown_compare">
                <field name="OP">GT</field>
                <value name="A"><block type="variables_get" id="adaptive_cooldown_get"><field name="VAR" id="adaptive_cooldown">Cooldown Ticks</field></block></value>
                <value name="B"><block type="math_number" id="adaptive_cooldown_zero"><field name="NUM">0</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="adaptive_cooldown_decrement">
                <field name="VAR" id="adaptive_cooldown">Cooldown Ticks</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="adaptive_cooldown_subtract">
                    <field name="OP">MINUS</field>
                    <value name="A"><block type="variables_get" id="adaptive_cooldown_current"><field name="VAR" id="adaptive_cooldown">Cooldown Ticks</field></block></value>
                    <value name="B"><block type="math_number" id="adaptive_cooldown_one"><field name="NUM">1</field></block></value>
                  </block>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="adaptive_signal_set">
                <field name="VAR" id="adaptive_signal">Adaptive Signal</field>
                <value name="VALUE">
                  <block type="adaptive_momentum_signal" id="adaptive_signal_block">
                    <value name="WARMUP" strategy_value="warmup_window"><shadow type="math_number"><field name="NUM">30</field></shadow></value>
                    <value name="SHORT_WINDOW" strategy_value="short_window"><shadow type="math_number"><field name="NUM">8</field></shadow></value>
                    <value name="LONG_WINDOW" strategy_value="long_window"><shadow type="math_number"><field name="NUM">20</field></shadow></value>
                    <value name="CONFIDENCE" strategy_value="confidence"><shadow type="math_number"><field name="NUM">60</field></shadow></value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="adaptive_call_or_put">
                    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="adaptive_call_compare">
                        <field name="OP">EQ</field>
                        <value name="A"><block type="variables_get" id="adaptive_call_signal"><field name="VAR" id="adaptive_signal">Adaptive Signal</field></block></value>
                        <value name="B"><block type="text" id="adaptive_call_text"><field name="TEXT">CALL</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0"><block type="purchase" id="adaptive_call_purchase"><field name="PURCHASE_LIST">CALL</field></block></statement>
                    <statement name="ELSE">
                      <block type="controls_if" id="adaptive_put_gate">
                        <value name="IF0">
                          <block type="logic_compare" id="adaptive_put_compare">
                            <field name="OP">EQ</field>
                            <value name="A"><block type="variables_get" id="adaptive_put_signal"><field name="VAR" id="adaptive_signal">Adaptive Signal</field></block></value>
                            <value name="B"><block type="text" id="adaptive_put_text"><field name="TEXT">PUT</field></block></value>
                          </block>
                        </value>
                        <statement name="DO0"><block type="purchase" id="adaptive_put_purchase"><field name="PURCHASE_LIST">PUT</field></block></statement>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="adaptive_after_purchase" x="780" y="520">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="adaptive_result_gate">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="adaptive_result_check"><field name="CHECK_RESULT">win</field></block>
        </value>
        <statement name="DO0"><block type="trade_again" id="adaptive_win_again"></block></statement>
        <statement name="ELSE">
          <block type="variables_set" id="adaptive_loss_cooldown">
            <field name="VAR" id="adaptive_cooldown">Cooldown Ticks</field>
            <value name="VALUE" strategy_value="cooldown_ticks"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
            <next><block type="trade_again" id="adaptive_loss_again"></block></next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>